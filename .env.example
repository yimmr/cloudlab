# ==============================================================================
# cloud 基础环境变量
#   setup 首次运行时会拷贝为 .env，请勿把含真实密码的 .env 提交到仓库
# ==============================================================================

# 站点 / 协议域名，需已解析到本机公网 IP
SITE_DOMAIN=site.localhost

# Docker 网关网络名，网站容器通过该 external 网络接入
NETWORK_ID=web_gateway

# --- 数据库 ---
MYSQL_ALLOW_EMPTY_PASSWORD=yes
MYSQL_ROOT_PASSWORD=

# 以下为站点容器可用的兼容变量名（WordPress 生态）
WORDPRESS_DB_HOST=db
WORDPRESS_DB_USER=root
WORDPRESS_DB_PASSWORD=